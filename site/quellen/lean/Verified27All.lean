/-- **Jede Zahl `1 < m < 2^27` fällt unter sich selbst.** -/
theorem descends_below_2_27 : ∀ m, 1 < m → m < 134217728 → Descends m := by
  intro m h1 hm
  by_cases hs : m < 67108864
  · exact descends_below_2_26 m h1 hs
  · exact descends_of_verifyOpen27 verifyOpen27_all (by omega) hm

/-- **Alle Zahlen von 1 bis 2^27 − 1 = 134 217 727 erreichen die 1** (Sieb + Kernel-Rechnung). -/
theorem reachesOne_below_2_27 : ∀ n, 0 < n → n < 134217728 → ReachesOne n := by
  intro n h0 h
  exact reachesOne_of_descends_upto 134217727 (fun m h1 hm => descends_below_2_27 m h1 (by omega))
    n h0 (by omega)

/-- **Ein nichttrivialer Zyklus enthält nur Zahlen `≥ 2^27`.** -/
theorem nontrivial_cycle_ge_2_27 {n p : Nat} (hp : Periodic n p) (h0 : 0 < n)
    (hnt : n ≠ 1 ∧ n ≠ 2 ∧ n ≠ 4) : ∀ k, 134217728 ≤ iter k n := by
  intro k
  have hr : ¬ ReachesOne n := fun hr => by
    rcases periodic_reachesOne hp hr with h | h | h <;> omega
  refine Nat.le_of_not_lt (fun hk => ?_)
  exact hr (reachesOne_of_iter (reachesOne_below_2_27 _ (iter_pos h0 k) hk))

/-- Kernel-Rechnung: die Zyklus-Ungleichung schliesst für `m = 2^27` alle `1 ≤ j ≤ 15 600`
aus (für `j = 15 601` gilt sie nicht mehr). -/
theorem cycleCheck_15600 : cycleCheck 134217728 15600 1 1 1 2 = true := by decide +kernel

/-- **Jeder nichttriviale Zyklus hat mindestens 15 601 ungerade Glieder.** -/
theorem cycle_odd_ge_15601 {n p : Nat} (hp : Periodic n p) (h0 : 0 < n)
    (hnt : n ≠ 1 ∧ n ≠ 2 ∧ n ≠ 4) : 15601 ≤ oddCount n p :=
  cycle_odd_gt hp h0 (nontrivial_cycle_ge_2_27 hp h0 hnt) cycleCheck_15600

set_option exponentiation.threshold 30000 in
/-- **Jeder nichttriviale Zyklus hat mindestens 40 328 Schritte**
(mindestens 15 601 ungerade und 24 727 gerade Glieder). -/
theorem cycle_length_ge_40328 {n p : Nat} (hp : Periodic n p) (h0 : 0 < n)
    (hnt : n ≠ 1 ∧ n ≠ 2 ∧ n ≠ 4) : 24727 ≤ evenCount n p ∧ 40328 ≤ p := by
  have hj := cycle_odd_ge_15601 hp h0 hnt
  have hbig := nontrivial_cycle_ge_2_27 hp h0 hnt
  obtain ⟨_, h3, _⟩ := cycle_inequalities (m := 134217728) hp h0 hbig
  have hsum := odd_add_even n p
  have h15601 : 3 ^ 15601 ≤ 3 ^ oddCount n p := Nat.pow_le_pow_right (by decide) hj
  have hpow : 2 ^ 24726 < 3 ^ 15601 := by decide +kernel
  have he : 24726 < evenCount n p := by
    have : 2 ^ 24726 < 2 ^ evenCount n p := by omega
    exact (Nat.pow_lt_pow_iff_right (by decide)).mp this
  omega

/-- **Struktur eines Gegenbeispiels**: Erreicht `n > 0` die 1 nicht, so enthält seine Folge
ein kleinstes Glied `m ≥ 2^27`, das nie unterschritten wird und dessen Rest modulo `2^20`
eine der 27 328 offenen Restklassen ist. -/
theorem counterexample_structure27 {n : Nat} (h0 : 0 < n) (h : ¬ ReachesOne n) :
    ∃ k, 134217728 ≤ iter k n ∧ IsOrbitMin (iter k n) ∧ iter k n % 1048576 ∈ survivors20 := by
  obtain ⟨k, hk⟩ := exists_orbitMin n
  have hbig : 134217728 ≤ iter k n := by
    refine Nat.le_of_not_lt (fun hlt => ?_)
    exact h (reachesOne_of_iter (reachesOne_below_2_27 _ (iter_pos h0 k) hlt))
  exact ⟨k, hbig, hk, orbitMin_mem_survivors20 (by omega) hk⟩

