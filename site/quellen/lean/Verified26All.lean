/-- **Jede Zahl `1 < m < 2^26` fällt unter sich selbst.** -/
theorem descends_below_2_26 : ∀ m, 1 < m → m < 67108864 → Descends m := by
  intro m h1 hm
  by_cases hs : m < 33554432
  · exact descends_below_2_25 m h1 hs
  · exact descends_of_verifyOpen26 verifyOpen26_all (by omega) hm

/-- **Alle Zahlen von 1 bis 2^26 − 1 = 67 108 863 erreichen die 1** (Sieb + Kernel-Rechnung). -/
theorem reachesOne_below_2_26 : ∀ n, 0 < n → n < 67108864 → ReachesOne n := by
  intro n h0 h
  exact reachesOne_of_descends_upto 67108863 (fun m h1 hm => descends_below_2_26 m h1 (by omega))
    n h0 (by omega)

/-- **Ein nichttrivialer Zyklus enthält nur Zahlen `≥ 2^26`.** -/
theorem nontrivial_cycle_ge_2_26 {n p : Nat} (hp : Periodic n p) (h0 : 0 < n)
    (hnt : n ≠ 1 ∧ n ≠ 2 ∧ n ≠ 4) : ∀ k, 67108864 ≤ iter k n := by
  intro k
  have hr : ¬ ReachesOne n := fun hr => by
    rcases periodic_reachesOne hp hr with h | h | h <;> omega
  refine Nat.le_of_not_lt (fun hk => ?_)
  exact hr (reachesOne_of_iter (reachesOne_below_2_26 _ (iter_pos h0 k) hk))

/-- Kernel-Rechnung: die Zyklus-Ungleichung schliesst für `m = 2^26` alle `1 ≤ j ≤ 14 935`
aus (für `j = 14 936` gilt sie nicht mehr). -/
theorem cycleCheck_14935 : cycleCheck 67108864 14935 1 1 1 2 = true := by decide +kernel

/-- **Jeder nichttriviale Zyklus hat mindestens 14 936 ungerade Glieder.** -/
theorem cycle_odd_ge_14936 {n p : Nat} (hp : Periodic n p) (h0 : 0 < n)
    (hnt : n ≠ 1 ∧ n ≠ 2 ∧ n ≠ 4) : 14936 ≤ oddCount n p :=
  cycle_odd_gt hp h0 (nontrivial_cycle_ge_2_26 hp h0 hnt) cycleCheck_14935

set_option exponentiation.threshold 30000 in
/-- **Jeder nichttriviale Zyklus hat mindestens 38 609 Schritte**
(mindestens 14 936 ungerade und 23 673 gerade Glieder). -/
theorem cycle_length_ge_38609 {n p : Nat} (hp : Periodic n p) (h0 : 0 < n)
    (hnt : n ≠ 1 ∧ n ≠ 2 ∧ n ≠ 4) : 23673 ≤ evenCount n p ∧ 38609 ≤ p := by
  have hj := cycle_odd_ge_14936 hp h0 hnt
  have hbig := nontrivial_cycle_ge_2_26 hp h0 hnt
  obtain ⟨_, h3, _⟩ := cycle_inequalities (m := 67108864) hp h0 hbig
  have hsum := odd_add_even n p
  have h14936 : 3 ^ 14936 ≤ 3 ^ oddCount n p := Nat.pow_le_pow_right (by decide) hj
  have hpow : 2 ^ 23672 < 3 ^ 14936 := by decide +kernel
  have he : 23672 < evenCount n p := by
    have : 2 ^ 23672 < 2 ^ evenCount n p := by omega
    exact (Nat.pow_lt_pow_iff_right (by decide)).mp this
  omega

/-- **Struktur eines Gegenbeispiels**: Erreicht `n > 0` die 1 nicht, so enthält seine Folge
ein kleinstes Glied `m ≥ 2^26`, das nie unterschritten wird und dessen Rest modulo `2^20`
eine der 27 328 offenen Restklassen ist. -/
theorem counterexample_structure26 {n : Nat} (h0 : 0 < n) (h : ¬ ReachesOne n) :
    ∃ k, 67108864 ≤ iter k n ∧ IsOrbitMin (iter k n) ∧ iter k n % 1048576 ∈ survivors20 := by
  obtain ⟨k, hk⟩ := exists_orbitMin n
  have hbig : 67108864 ≤ iter k n := by
    refine Nat.le_of_not_lt (fun hlt => ?_)
    exact h (reachesOne_of_iter (reachesOne_below_2_26 _ (iter_pos h0 k) hlt))
  exact ⟨k, hbig, hk, orbitMin_mem_survivors20 (by omega) hk⟩

